{
  "name": "bastion-pilot-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "BastionPilot — bring AI agents to bastion-host web terminals. Browser extension + local bridge (MCP server & built-in agent loop).",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/gen-icons.mjs",
    "extension:zip": "pnpm --filter @bastion-pilot/extension zip",
    "all": "pnpm build && pnpm typecheck && pnpm test && pnpm lint"
  },
  "devDependencies": {
    "eslint": "^9.30.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.35.0"
  }
}
